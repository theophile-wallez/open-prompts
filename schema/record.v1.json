{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theophile-wallez/open-prompts/blob/main/schema/record.v1.json",
  "title": "Open Prompts record, version 1",
  "description": "One line of an Open Prompts JSONL file. See SPEC.md section 4.",
  "type": "object",
  "required": ["v", "timestamp", "agent", "agent_version", "model", "session", "prompt"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "agent": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "agent_version": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "session": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
